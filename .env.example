# Nama image container di registry.
# Deployment otomatis memakai digest APP_IMAGE dari hasil build.
# Untuk restart manual sesudah deploy, gunakan juga --env-file .release.env.
# Ganti OWNER/REPO sesuai repository GitHub Anda.
IMAGE_NAME=ghcr.io/owner/repo

# Tag default yang dipakai saat server melakukan pull.
IMAGE_TAG=latest

# Nama container di server.
CONTAINER_NAME=fantastik

# Port host yang akan diekspos.
APP_PORT=8501

# Timezone aplikasi.
TZ=Asia/Makassar
